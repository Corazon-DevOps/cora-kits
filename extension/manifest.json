{
  "manifest_version": 3,
  "name": "Cora Extrator",
  "version": "1.0.0",
  "description": "Extraia cores, tipografia e logo da identidade visual de qualquer site, direto do navegador.",
  "default_locale": "pt_BR",
  "permissions": ["activeTab", "scripting", "storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Cora Extrator",
    "default_icon": {
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "icons": {
    "48": "icon.png",
    "128": "icon.png"
  }
}
